<!doctype html>
<html lang="en">
<head>
    <title>Login - NexaChat</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" rel="stylesheet">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <style>
        body {
            background-color: #0f141c;
            color: #e1e4e8;
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .auth-card {
            background-color: #1a202c;
            border: 1px solid #2d3748;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
            width: 100%;
            max-width: 420px;
            padding: 30px;
        }
        .form-control {
            background-color: #0f141c;
            border: 1px solid #4a5568;
            color: #fff;
        }
        .form-control:focus {
            background-color: #0f141c;
            border-color: #3182ce;
            color: #fff;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="text-center mb-4">
            <h3 class="font-weight-bold text-primary"><i class="fa fa-comments"></i> NexaChat</h3>
            <p class="text-muted small">Sign in with End-to-End Encryption</p>
        </div>

        <% if(typeof message !== 'undefined'){ %>
            <div class="alert alert-danger py-2" role="alert">
                <small><%= message %></small>
            </div>
        <% } %>

        <form action="/" method="post">
            <div class="form-group">
                <label class="small text-muted font-weight-bold">Email address</label>
                <input type="email" name="email" class="form-control" placeholder="Enter your email" required autofocus>
            </div>
            <div class="form-group">
                <label class="small text-muted font-weight-bold">Password</label>
                <input type="password" name="password" class="form-control" placeholder="Enter your password" required>
            </div>
            <button type="submit" class="btn btn-primary btn-block mt-4 py-2 font-weight-bold">
                <i class="fa fa-sign-in mr-1"></i> Log In
            </button>
        </form>

        <div class="text-center mt-4">
            <p class="text-muted small mb-0">Don't have an account? <a href="/register" class="text-primary font-weight-bold">Create Account</a></p>
        </div>
    </div>
</body>
</html>